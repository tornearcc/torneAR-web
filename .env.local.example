# Mismo proyecto Supabase que la app móvil (tornear-db, ref yusfykqimalghmmhlfdn).
# NUNCA agregar la service_role key acá ni en ningún .env que llegue al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Meta App para el flujo de OAuth de Instagram (/dashboard/social, Fase 1
# pivot: integración automatizada). App ID no es secreto — reusar el mismo
# que ya usa tornear/.env (EXPO_PUBLIC_INSTAGRAM_APP_ID) si es la misma app
# de Meta, sumándole ahí el producto "API setup with Instagram login".
# App Secret SÍ es secreto: sólo server-side (nunca NEXT_PUBLIC_).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Debe coincidir EXACTO con una "Valid OAuth Redirect URI" configurada en
# Meta for Developers > tu app > Instagram > API setup with Instagram login.
INSTAGRAM_OAUTH_REDIRECT_URI=https://admin.tornear.app/api/instagram/oauth/callback
